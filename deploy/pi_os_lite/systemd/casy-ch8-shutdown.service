[Unit]
Description=CASY Shutdown Pi on RC CH8 High
After=casy-mavproxy.service
Wants=casy-mavproxy.service

[Service]
Type=simple
User=casy
Environment=ENV_FILE=/etc/casy-drone/pi_os_lite.env
EnvironmentFile=/etc/casy-drone/pi_os_lite.env
ExecStart=/bin/bash -lc 'cd "$PROJECT_DIR" && exec /usr/bin/python3 deploy/pi_os_lite/shutdown_on_ch8.py'
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
