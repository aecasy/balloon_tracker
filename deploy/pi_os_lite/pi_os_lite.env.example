# Copy to /etc/casy-drone/pi_os_lite.env on the Pi and edit if the network changes.

PROJECT_DIR=/home/casy/balloon_tracker
ENV_FILE=/etc/casy-drone/pi_os_lite.env

ROS_MASTER_URI=http://192.168.1.154:11311
ROS_IP=192.168.1.168

DOCKER_IMAGE=casy-ros-node
DOCKER_BIN=docker

FC_UART=/dev/serial0
MAVLINK_BAUD=921600
MAVLINK_LOGFILE=/var/log/mavproxy/Smav.tlog
MAVLINK_OUT_GROUND=udp:192.168.1.115:14550
MAVLINK_OUT_LOCAL_1=udp:127.0.0.1:14551
MAVLINK_OUT_LOCAL_2=udp:127.0.0.1:14552
MAVLINK_OUT_LOCAL_3=udp:127.0.0.1:14553
MAVLINK_OUT_TCP=tcpin:0.0.0.0:5760
MAVLINK_RC_CH7_ENDPOINT=udp:127.0.0.1:14551
MAVLINK_RC_OVERRIDE_ENDPOINT=udp:127.0.0.1:14552
MAVLINK_SHUTDOWN_PORT=14553
MAVPROXY_BIN=/opt/casy-drone/mavproxy-venv/bin/mavproxy.py

RC_OVERRIDE_TOPIC=quad_commands
RC_OVERRIDE_RATE_HZ=50
AUTONOMY_ENABLE_TOPIC=autonomy_enable
RC_CH7_HIGH_THRESH=1800
RC_CH8_SHUTDOWN_HIGH=1900
RC_CH8_RESET_LOW=1500
RC_CH8_HOLD_SEC=1.0

TRACKER_CONFIG=config/green_tracker.json
TRACKER_CALIBRATION=config/camera_calibration_1280x720_raw2304x1296.json
TRACKER_WIDTH=1280
TRACKER_HEIGHT=720
TRACKER_RAW_WIDTH=2304
TRACKER_RAW_HEIGHT=1296
TRACKER_METHOD=scored
LATENCY_DIAGNOSTICS=0
TARGET_LATENCY_TOPIC=/target_latency

SIMULINK_ROS_DEVICE_IMAGE=casy-simulink-ros-device
SIMULINK_ROS_DEVICE_SSH_PORT=2222
SIMULINK_ROS_DEVICE_PASSWORD_FILE=/etc/casy-drone/simulink_ros_device_password
SIMULINK_CATKIN_HOST_DIR=/home/casy/simulink_catkin_ws
