FROM ros:noetic-ros-base-focal

ENV DEBIAN_FRONTEND=noninteractive
ENV SIMULINK_ROS_DEVICE_SSH_PORT=22
ENV SIMULINK_CATKIN_WORKSPACE=/home/ubuntu/catkin_ws

RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    openssh-server \
    python3 \
    python3-catkin-tools \
    python3-future \
    python3-lxml \
    python3-pip \
    python3-serial \
    ros-noetic-geometry-msgs \
    ros-noetic-roscpp \
    ros-noetic-rospy \
    ros-noetic-std-msgs \
    sudo \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir --no-deps pymavlink==2.4.49

RUN useradd -m -s /bin/bash ubuntu \
    && usermod -aG sudo ubuntu \
    && mkdir -p /home/ubuntu/catkin_ws/src /home/user /run/sshd \
    && ln -s /home/ubuntu/catkin_ws /home/user/catkin_ws \
    && chown -R ubuntu:ubuntu /home/ubuntu/catkin_ws \
    && chown ubuntu:ubuntu /home/user \
    && chown -h ubuntu:ubuntu /home/user/catkin_ws \
    && printf "source /opt/ros/noetic/setup.bash\nif [ -f /home/ubuntu/catkin_ws/devel/setup.bash ]; then source /home/ubuntu/catkin_ws/devel/setup.bash; fi\n" > /home/ubuntu/.bashrc \
    && chown ubuntu:ubuntu /home/ubuntu/.bashrc

COPY docker/simulink_ros_device/entrypoint.sh /usr/local/bin/simulink-ros-device-entrypoint
RUN chmod +x /usr/local/bin/simulink-ros-device-entrypoint

EXPOSE 22

ENTRYPOINT ["/usr/local/bin/simulink-ros-device-entrypoint"]
